<% layout('/layouts/boilerplate') -%>
<body>
    

<div class="newListingBody">
    <h1 class="addNew">add new listing</h1>
    <form method="post" action="/listings" class="newListing needs-validation" novalidate enctype="multipart/form-data">
        <div class="title col-md-12">
            <label for="title" class="form-label">title</label>
            <input id="title" type="text" placeholder="add title" name="listing[title]" class="addTitle" required>
             <div class="valid-feedback">
      Looks good!
    </div>
    <div class="invalid-feedback">
        Please choose a title
      </div>
        </div>
        
        <div class="description col-md-12">
            <label for="description" class="form-label">description</label>
            <textarea id="description" name="listing[description]" placeholder="add listing description" required ></textarea>
              <div class="valid-feedback">
      Looks good!
    </div>
     <div class="invalid-feedback">
        Please choose a description
      </div>

        </div>
        
        <div class="price col-md-12">
             <label for="price" class="form-label">price</label>
              <input type="text" name="listing[price]" required>
              <div class="valid-feedback">
      Looks good!
    </div>
     <div class="invalid-feedback">
        Please choose a price
      </div>

        </div>
        <div class="location col-md-12">
            <label for="location" class="form-label">location</label>
             <input id="location" type="text" placeholder="add location" name="listing[location]" required>
             <div class="valid-feedback">
      Looks good!
    </div>
     <div class="invalid-feedback">
        Please choose a location
      </div>


        </div>
        
       <div class="country col-md-12">
         <label for="country" class="form-label">country</label>
         <input type="text" placeholder="add country" name="listing[country]" required>
         <div class="valid-feedback">
      Looks good!
    </div>
     <div class="invalid-feedback">
        Please choose a country
      </div>


       </div>
        <div class="image col-md-12 ">
         <label for="image" class="form-label">image</label>
         <input type="file"  name="listing[image]" style="margin-bottom: 1rem;" required >
        


       </div>
        
          
          <button>add listing</button>
        
    </form>
</div>
</body>
